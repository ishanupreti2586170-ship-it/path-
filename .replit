modules = ["nodejs-20", "web", "python-3.11"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"
integrations = ["github:1.0.0", "stripe:1.0.0"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5050
externalPort = 3002

[[ports]]
localPort = 5051
externalPort = 3003

[[ports]]
localPort = 5052
externalPort = 4200

[[ports]]
localPort = 24678
externalPort = 3000

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.shared]
CASHFREE_ENV = "production"
FULL_REPORT_PRICE_INR = "399"
BYPASS_EMAIL = "joship696@gmail.com"

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "NODE_ENV=production node dist/server.cjs"]
build = ["npm", "run", "build"]
